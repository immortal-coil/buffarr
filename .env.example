# Copy to .env and fill in before `docker compose up`.

# Container image registry prefix for the buffarr-* images. Leave blank to build
# and run them locally (tagged buffarr/buffarr-*). Set it to your registry
# (e.g. registry.example.com/yourname) to pull pre-built images instead.
IMAGE_REGISTRY=

# In-container path nginx/backend treat as the cache storage root (R10).
# Changing this also moves where the cache-data volume is mounted inside
# both containers (docker-compose.yml), so it takes effect on next
# `docker compose up`, not a live reload. Does NOT change which host disk
# backs the volume -- that's controlled by Docker's volume storage, not
# this path.
CACHE_ROOT=/data/cache

# nginx's own disk-exhaustion safety valve (proxy_cache_path's max_size/
# min_free) -- a size backstop, not the primary eviction policy. The Go backend
# is the primary, Lock-aware eviction authority (KTD4); these only stop nginx
# from filling the disk past these limits and are not Lock-aware. Size them to
# the disk backing the cache volume (set CACHE_MAX_SIZE below the disk size, and
# keep generous CACHE_MIN_FREE headroom).
CACHE_MAX_SIZE=500g
CACHE_MIN_FREE=10g

# nginx's time-based eviction (proxy_cache_path inactive): a last-access timer
# that removes a cached slice idle longer than this, regardless of free space.
# Default 365d. Raise it (e.g. 3650d, ~10 years) to effectively disable
# time-based eviction. Lower it only deliberately -- a short value silently
# expires unaccessed slices on a timer, including monitored/Locked content, with
# no backend involvement.
CACHE_INACTIVE=365d

# Size of nginx's in-RAM cache key index (proxy_cache_path keys_zone). This is
# NOT the cached data -- it's the index of which 1 MB slices are cached. ~8000
# keys fit per 1 MB of zone, and each ~1 MB slice needs one key, so the zone is
# an effective cache cap independent of disk: 100m ~= ~800 GB of content, after
# which nginx evicts keys (re-downloading slices) even with free disk. Size it to
# the disk: ~470m covers a 3.7 TB disk; round up for headroom. Costs that much RAM.
CACHE_KEYS_ZONE=100m

# NOTE: the minimum game size (the single cutoff that decides what counts as a
# real game -- below it an identified game drops out of the Library, and smaller
# fragments below it are what the Unmanaged cache's "Purge orphans" button
# sweeps) is no longer an env var. It is now edited live in the webui under
# Settings, so changing it takes effect immediately with no redeploy.
# Defaults to 5 GiB until set there.

# OPTIONAL: Operator's Steam Web API key (https://steamcommunity.com/dev/
# apikey) and the single allowlisted operator SteamID64 (KTD13; login
# attempts from any other Steam account are rejected). Both can instead be
# entered through the webui's first-run setup form (visiting the site with
# neither configured redirects there) -- whichever is set here takes
# precedence over what was entered through that form. Leave both blank to
# configure entirely through the web setup form, with no .env editing.
#
# Note: unlike everything else in this file, the setup form persists these
# two values into the catalog SQLite DB, not just into the running
# container's environment -- a deliberate choice (see internal/web/
# server.go) so the webui can be fully configured without touching .env.
STEAM_WEB_API_KEY=
STEAM_OPERATOR_ID64=

# Shared secret the backend sends on PURGE requests; nginx validates it
# independently of source IP (KTD14). Generate with e.g. `openssl rand -hex 32`.
NGINX_PURGE_SECRET=

# REQUIRED, no safe default: this cache server's own LAN IP address (e.g.
# 192.168.1.10) -- the address game clients are pointed at via DNS for every
# enabled CDN domain (R9). A container can only see its own Docker-internal
# IP, which is meaningless to LAN clients, so this cannot be auto-detected.
BUFFARR_IP=

# OPTIONAL: set to "true" only when the backend sits behind a trusted,
# TLS-terminating reverse proxy. It then honors X-Forwarded-Proto/Host when
# building the Steam login return URL, so post-login redirects land on the
# public address instead of the backend-local scheme/port. Leave unset when
# clients reach :9443 directly -- these headers are client-controlled, so
# trusting them without a proxy in front would let a caller steer the redirect.
TRUST_PROXY_HEADERS=

# OPTIONAL: static key that enables the JSON API under /api/v1/ for scripts
# and integrations (Grafana, Home Assistant, cron preloads -- see docs/API.md).
# Generate with e.g. `openssl rand -hex 32`. Leave blank to keep the API
# disabled entirely.
BUFFARR_API_KEY=

# Upstream DNS server dnsmasq forwards non-CDN queries to. Defaults to
# 1.1.1.1 if unset.
UPSTREAM_DNS=1.1.1.1

# Maximum seconds a single triggered prefill run is allowed before the
# sidecar kills it and reports failure (U8). Generous by default --
# large libraries/slow links can legitimately take a long time; this is
# a hard backstop, not a tuned expectation.
#
# REQUIRED ONE-TIME SETUP, separate from Steam OpenID login (R11): the
# webui login only proves who the operator is (a SteamID64) -- it grants
# no access to the operator's Steam account itself. The prefill sidecar
# needs its OWN, separate interactive login (full Steam credentials +
# Steam Guard) before any triggered prefill can work, since it downloads
# depot content on the operator's behalf. Before triggering prefill for
# the first time, run once:
#   docker compose run --rm --entrypoint /SteamPrefill prefill
# and follow the interactive prompts. This persists credentials into the
# same `prefill-shared` volume the automated trigger flow uses, so it
# only needs to be done once (until Steam invalidates the session).
# Skipping this step doesn't hang forever -- it fails after
# PREFILL_MAX_RUNTIME_SECONDS, surfaced as a generic prefill failure.
PREFILL_MAX_RUNTIME_SECONDS=7200
